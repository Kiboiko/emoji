.btn-withdraw {
  width: 100%;
  padding: 12px 20px;
  border-radius: 10px;
  border: none;
  background: var(--bg-tertiary);
  color: var(--text-primary);
  font-size: 15px;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.2s;
  margin-bottom: 16px;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
}

.btn-withdraw:hover {
  background: var(--bg-secondary);
  transform: translateY(-1px);
}
