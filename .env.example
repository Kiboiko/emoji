# ============================================================
# Marketplace 2.0 — шаблон переменных окружения
# Скопировать в .env и заполнить реальными значениями:
#     cp .env.example .env
# Файл .env в git НЕ попадает (см. .gitignore).
# ============================================================

# --- База данных ---------------------------------------------
# Хост "postgres" — это имя сервиса в docker-compose.
# Для запуска backend вне docker поменять на 127.0.0.1 и порт из POSTGRES_PORT.
DATABASE_URL=postgresql+asyncpg://marketplace_user:CHANGE_ME@postgres:5432/marketplace
DB_NAME=marketplace
DB_USER=marketplace_user
DB_PASSWORD=CHANGE_ME

# --- Приложение ----------------------------------------------
APP_NAME=Marketplace 2.0
SITE_URL=http://localhost:8080

# ВАЖНО: DEBUG=true открывает служебный эндпоинт /api/auth/dev,
# который выдаёт админский токен без пароля, и включает вывод всего SQL в лог.
# На боевом сервере ВСЕГДА false.
DEBUG=false

# Вывод всех SQL-запросов в лог. Отделено от DEBUG: включать только для отладки.
SQL_ECHO=false

# Флаг Secure у cookie refresh-токена админки.
# На проде (HTTPS) — true. Локально по HTTP обязательно false, иначе вход в админку не работает.
COOKIE_SECURE=true

# --- Безопасность --------------------------------------------
# Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=CHANGE_ME_GENERATE_A_LONG_RANDOM_STRING

# --- Админка -------------------------------------------------
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME

# --- Telegram ------------------------------------------------
# Токен от @BotFather. Для локальной разработки завести ОТДЕЛЬНОГО тестового бота:
# боевой и локальный бот не могут читать апдейты одновременно.
TELEGRAM_BOT_TOKEN=CHANGE_ME
VITE_BOT_USERNAME=your_bot_username

# ID канала(ов) для публикации отзывов, через запятую
REVIEWS_CHANNEL_ID=

# ID чата(ов) администраторов для уведомлений, через запятую
ADMIN_CHAT_ID=

# --- Оплата --------------------------------------------------
# CryptoBot — УДАЛЯЕТСЯ на этапе 3 (замена на TON Connect).
# Оставлено для совместимости до завершения миграции.
CRYPTOBOT_API_TOKEN=
CRYPTOBOT_TESTNET=true

# --- CORS ----------------------------------------------------
# JSON-массив разрешённых origin
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:8080"]

# --- Фронтенд (подставляется на этапе сборки) ----------------
VITE_API_URL=http://localhost:8080/api

# --- Порты (внешние, чтобы не конфликтовать с другими проектами) ---
POSTGRES_PORT=5433
HTTP_PORT=8080
HTTPS_PORT=8443
