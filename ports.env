# Порты для избежания конфликтов с другими проектами
# По умолчанию используются нестандартные порты

# PostgreSQL (внешний порт, по умолчанию 5433 вместо 5432)
POSTGRES_PORT=5433

# HTTP (внешний порт, по умолчанию 8080 вместо 80)
HTTP_PORT=8080

# HTTPS (внешний порт, по умолчанию 8443 вместо 443)
HTTPS_PORT=8443

# Примечание: Для стандартных портов (80/443) раскомментируйте:
# HTTP_PORT=80
# HTTPS_PORT=443
